# Settings for the Falcon backend. Google login will be implemented separately.
# Copy this file to .env and fill in the values locally.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# The Google account email that will become the initial dashboard Admin.
BOOTSTRAP_ADMIN_EMAIL=

# Local snap-installed LXD. Requests use a connect/read timeout in seconds;
# this is not a deadline for an entire operation.
LXD_SOCKET_PATH=/var/snap/lxd/common/lxd/unix.socket
LXD_TIMEOUT_SECONDS=5
